<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Shop - App View</title>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; -webkit-tap-highlight-color: transparent; }

        body {
            background-color: #f4f5f7;
            display: flex;
            justify-content: center;
        }

        /* App Container */
        .app-container {
            width: 100%;
            max-width: 414px;
            background: #ffffff;
            min-height: 100vh;
            position: relative;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            padding-bottom: 70px;
        }

        /* Top Header with Search */
        .app-header {
            padding: 15px 20px;
            background: #ffffff;
            position: sticky;
            top: 0;
            z-index: 10;
        }
        .search-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }
        .search-box {
            flex: 1;
            background: #f4f5f7;
            display: flex;
            align-items: center;
            padding: 10px 15px;
            border-radius: 12px;
            gap: 10px;
        }
        .search-box input {
            border: none; background: transparent; outline: none;
            width: 100%; font-size: 14px; color: #1a1f36;
        }
        .search-box i { color: #8a8d93; }
        .header-icon-btn {
            position: relative;
            background: #f4f5f7;
            width: 40px; height: 40px;
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            color: #1a1f36; cursor: pointer;
        }
        .badge-dot {
            position: absolute; top: 10px; right: 10px;
            width: 8px; height: 8px; background: #ff4757;
            border-radius: 50%;
        }

        /* Category Chips Bar */
        .category-scroll {
            display: flex;
            gap: 10px;
            padding: 10px 20px;
            overflow-x: auto;
            background: #ffffff;
            scrollbar-width: none;
        }
        .category-scroll::-webkit-scrollbar { display: none; }
        
        .cat-chip {
            padding: 8px 16px;
            background: #f4f5f7;
            border-radius: 20px;
            font-size: 13px; font-weight: 600;
            color: #8a8d93;
            white-space: nowrap;
            cursor: pointer;
            border: 1px solid transparent;
            transition: 0.2s;
        }
        .cat-chip.active {
            background: #e8f5f3;
            color: #2f9c8f;
            border-color: #2f9c8f;
        }

        /* Promo Banner */
        .banner-container {
            padding: 10px 20px;
        }
        .promo-banner {
            background: linear-gradient(135deg, #1a1f36, #2f9c8f);
            border-radius: 15px;
            padding: 20px;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .promo-banner h2 { font-size: 20px; font-weight: 700; margin-bottom: 5px; }
        .promo-banner p { font-size: 12px; opacity: 0.9; margin-bottom: 12px; }
        .promo-btn {
            background: white; color: #1a1f36;
            border: none; padding: 6px 14px;
            border-radius: 8px; font-size: 12px; font-weight: 700;
            cursor: pointer;
        }

        /* Section Title */
        .section-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 20px 10px 20px;
        }
        .section-title h3 { font-size: 16px; font-weight: 700; color: #1a1f36; }
        .section-title span { font-size: 13px; color: #2f9c8f; font-weight: 600; cursor: pointer; }

        /* Product Grid (2 Columns like App) */
        .product-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            padding: 0 20px 20px 20px;
        }

        .product-card {
            background: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #eee;
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        .card-img-box {
            width: 100%;
            height: 160px;
            background: #f8f9fa;
            position: relative;
        }
        .card-img-box img {
            width: 100%; height: 100%; object-fit: cover;
        }
        .fav-icon {
            position: absolute; top: 10px; right: 10px;
            background: white; width: 28px; height: 28px;
            border-radius: 50%; display: flex; align-items: center; justify-content: center;
            font-size: 12px; color: #8a8d93; box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .card-details {
            padding: 12px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }
        .card-title {
            font-size: 13px; font-weight: 600; color: #1a1f36;
            margin-bottom: 6px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .card-meta {
            display: flex; align-items: center; justify-content: space-between;
            margin-top: auto;
        }
        .card-price {
            font-size: 15px; font-weight: 700; color: #2f9c8f;
        }
        .card-rating {
            font-size: 11px; color: #8a8d93; display: flex; align-items: center; gap: 3px;
        }
        .card-rating i { color: #f39c12; }

        /* Bottom Nav Bar */
        .bottom-nav {
            position: fixed;
            bottom: 0; width: 100%; max-width: 414px;
            background: #ffffff;
            border-top: 1px solid #eee;
            display: flex;
            justify-content: space-around;
            padding: 12px 0;
            z-index: 100;
        }
        .nav-item {
            display: flex; flex-direction: column; align-items: center; gap: 4px;
            text-decoration: none; color: #8a8d93; font-size: 11px; font-weight: 500;
        }
        .nav-item.active { color: #2f9c8f; }
        .nav-item i { font-size: 18px; }
    </style>
</head>
<body>

    <div class="app-container">
        <!-- Header -->
        <div class="app-header">
            <div class="search-row">
                <div class="search-box">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" placeholder="Search 3D clothes, shoes...">
                </div>
                <div class="header-icon-btn">
                    <i class="fa-regular fa-bell"></i>
                    <span class="badge-dot"></span>
                </div>
            </div>
        </div>

        <!-- Categories -->
        <div class="category-scroll">
            <div class="cat-chip active">All Items</div>
            <div class="cat-chip">👕 T-Shirts</div>
            <div class="cat-chip">👔 Shirts</div>
            <div class="cat-chip">👟 Sneakers</div>
            <div class="cat-chip">🧥 Jackets</div>
        </div>

        <!-- Banner -->
        <div class="banner-container">
            <div class="promo-banner">
                <div>
                    <h2>#FASHION DAY</h2>
                    <p>Discover 3D fashion style in your space.</p>
                    <button class="promo-btn" onclick="window.location.href='/product'">Check this out</button>
                </div>
            </div>
        </div>

        <!-- Product Section -->
        <div class="section-title">
            <h3>Best Sale Product</h3>
            <span>See more</span>
        </div>

        <!-- Product Grid -->
        <div class="product-grid">
            
            <!-- Card 1 -->
            <a href="/product" class="product-card">
                <div class="card-img-box">
                    <img src="https://picsum.photos/400/500?random=10" alt="Product">
                    <div class="fav-icon"><i class="fa-regular fa-heart"></i></div>
                </div>
                <div class="card-details">
                    <div class="card-title">Essentials Men's Short-Sleeve Crewneck T-Shirt</div>
                    <div class="card-meta">
                        <span class="card-price">$12.00</span>
                        <span class="card-rating"><i class="fa-solid fa-star"></i> 4.9 (25k)</span>
                    </div>
                </div>
            </a>

            <!-- Card 2 -->
            <a href="/product" class="product-card">
                <div class="card-img-box">
                    <img src="https://picsum.photos/400/500?random=20" alt="Product">
                    <div class="fav-icon"><i class="fa-regular fa-heart"></i></div>
                </div>
                <div class="card-details">
                    <div class="card-title">Essentials Men's Hoodie Colorblock Jacket</div>
                    <div class="card-meta">
                        <span class="card-price">$18.00</span>
                        <span class="card-rating"><i class="fa-solid fa-star"></i> 4.8 (18k)</span>
                    </div>
                </div>
            </a>

            <!-- Card 3 -->
            <a href="/product" class="product-card">
                <div class="card-img-box">
                    <img src="https://picsum.photos/400/500?random=30" alt="Product">
                    <div class="fav-icon"><i class="fa-regular fa-heart"></i></div>
                </div>
                <div class="card-details">
                    <div class="card-title">Vintage Graphic Printed Summer Resort Shirt</div>
                    <div class="card-meta">
                        <span class="card-price">$14.00</span>
                        <span class="card-rating"><i class="fa-solid fa-star"></i> 4.7 (12k)</span>
                    </div>
                </div>
            </a>

            <!-- Card 4 -->
            <a href="/product" class="product-card">
                <div class="card-img-box">
                    <img src="https://picsum.photos/400/500?random=40" alt="Product">
                    <div class="fav-icon"><i class="fa-regular fa-heart"></i></div>
                </div>
                <div class="card-details">
                    <div class="card-title">Casual Regular Fit Oxford Cotton Shirt</div>
                    <div class="card-meta">
                        <span class="card-price">$22.00</span>
                        <span class="card-rating"><i class="fa-solid fa-star"></i> 4.9 (30k)</span>
                    </div>
                </div>
            </a>

        </div>

        <!-- Bottom Navigation Bar -->
        <div class="bottom-nav">
            <a href="/shop" class="nav-item active">
                <i class="fa-solid fa-house"></i>
                <span>Home</span>
            </a>
            <a href="/shop" class="nav-item">
                <i class="fa-solid fa-box-archive"></i>
                <span>Voucher</span>
            </a>
            <a href="/shop" class="nav-item">
                <i class="fa-solid fa-wallet"></i>
                <span>Wallet</span>
            </a>
            <a href="/shop" class="nav-item">
                <i class="fa-solid fa-gear"></i>
                <span>Settings</span>
            </a>
        </div>
    </div>

</body>
</html>
