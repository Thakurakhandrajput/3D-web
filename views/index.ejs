<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Webglut - Minimal 3D Store</title>
    <!-- Three.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <!-- GSAP for Smooth Animations -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>

    <style>
        /* Importing elegant fonts like the video */
        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500&display=swap');

        :root {
            --bg-color: #F4F1EC; /* Warm beige background */
            --text-color: #2D2B2A; /* Dark charcoal text */
            --accent-color: #D36B4A; /* Terracotta / Rust accent */
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }

        /* Navbar */
        nav {
            display: flex; justify-content: space-between; align-items: center;
            padding: 25px 50px; position: absolute; width: 100%; z-index: 10;
        }
        .logo { display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 18px; }
        .logo-icon { width: 16px; height: 16px; background: var(--accent-color); border-radius: 3px; }
        .nav-links { display: flex; gap: 40px; font-size: 13px; font-weight: 500; }
        .nav-links a { text-decoration: none; color: var(--text-color); }
        .nav-icons { display: flex; gap: 20px; font-size: 16px; cursor: pointer; }

        /* Hero Section */
        .hero {
            min-height: 100vh; display: flex; flex-direction: column;
            justify-content: center; align-items: center; position: relative;
            padding-top: 80px;
        }

        /* The Arch (3D Container) mimicking the video */
        .arch-container {
            width: 340px; height: 480px;
            border-radius: 170px 170px 0 0; /* Creates the beautiful Arch shape */
            background: #E8E4DB;
            position: relative; overflow: hidden;
            box-shadow: inset 0 20px 50px rgba(0,0,0,0.03), 0 20px 40px rgba(0,0,0,0.05);
            opacity: 0; transform: scale(0.95);
        }
        #canvas-container {
            width: 100%; height: 100%; position: absolute; top: 0; left: 0; outline: none;
        }

        /* Text below the arch */
        .hero-text {
            text-align: center; margin-top: 40px; z-index: 2;
            opacity: 0; transform: translateY(20px);
        }
        .hero-text h1 {
            font-family: 'Playfair Display', serif; font-size: 3rem;
            font-weight: 400; color: var(--text-color); line-height: 1.2;
        }

        .explore-btn {
            margin-top: 25px;
            background: var(--accent-color); color: white;
            border: none; padding: 12px 30px; border-radius: 30px;
            font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 500;
            cursor: pointer; opacity: 0; transition: 0.3s;
        }
        .explore-btn:hover { background: #b5573a; }

        /* Mobile responsiveness */
        @media (max-width: 768px) {
            nav { padding: 20px; }
            .nav-links { display: none; } /* Hide on mobile like an app */
            .arch-container { width: 280px; height: 400px; border-radius: 140px 140px 0 0; }
            .hero-text h1 { font-size: 2.2rem; }
        }
    </style>
</head>
<body>

    <nav>
        <div class="logo"><div class="logo-icon"></div> Webglut</div>
        <div class="nav-links">
            <a href="/">Home</a>
            <a href="#">About</a>
            <a href="/shop">Products</a>
            <a href="#">Collections</a>
            <a href="#">Contact</a>
        </div>
        <div class="nav-icons">
            <span>🔍</span> <span>🛒</span> <span>👤</span>
        </div>
    </nav>

    <section class="hero">
        <!-- The elegant Arch containing the 3D model -->
        <div class="arch-container" id="arch">
            <div id="canvas-container"></div>
        </div>
        
        <div class="hero-text" id="text-block">
            <h1>Turn Your House Into<br>a Story Worth Living</h1>
            <button class="explore-btn" id="btn" onclick="window.location.href='/shop'">Explore Collection</button>
        </div>
    </section>

    <script>
        // --- GSAP Smooth Entry Animations ---
        gsap.to("#arch", { opacity: 1, scale: 1, duration: 1.5, ease: "power3.out", delay: 0.2 });
        gsap.to("#text-block", { opacity: 1, y: 0, duration: 1.2, ease: "power3.out", delay: 0.6 });
        gsap.to("#btn", { opacity: 1, duration: 1, ease: "power3.out", delay: 1 });

        // --- Three.js Setup (Elegant Ceramic Look) ---
        const container = document.getElementById('canvas-container');
        const scene = new THREE.Scene();
        scene.background = new THREE.Color('#E8E4DB'); // Matches arch interior

        const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 100);
        camera.position.z = 5;

        const renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setSize(container.clientWidth, container.clientHeight);
        renderer.setPixelRatio(window.devicePixelRatio);
        container.appendChild(renderer.domElement);

        // Soft, studio-style lighting
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
        scene.add(ambientLight);

        const dirLight = new THREE.DirectionalLight(0xfffaed, 0.8);
        dirLight.position.set(5, 5, 5);
        scene.add(dirLight);

        // Abstract elegant shape (Torus) with Terracotta color
        const geometry = new THREE.TorusGeometry(1, 0.4, 64, 100);
        const material = new THREE.MeshStandardMaterial({ 
            color: 0xD36B4A, 
            roughness: 0.3, 
            metalness: 0.1 
        });
        const mesh = new THREE.Mesh(geometry, material);
        scene.add(mesh);

        // Mouse interaction for slight 3D movement
        let mouseX = 0; let mouseY = 0;
        document.addEventListener('mousemove', (event) => {
            mouseX = (event.clientX / window.innerWidth) * 2 - 1;
            mouseY = -(event.clientY / window.innerHeight) * 2 + 1;
        });

        function animate() {
            requestAnimationFrame(animate);
            // Smooth auto-rotation
            mesh.rotation.y += 0.005;
            mesh.rotation.x += 0.002;
            
            // Interactive mouse follow
            mesh.position.x += (mouseX * 0.5 - mesh.position.x) * 0.05;
            mesh.position.y += (mouseY * 0.5 - mesh.position.y) * 0.05;

            renderer.render(scene, camera);
        }
        animate();

        window.addEventListener('resize', () => {
            if(container) {
                camera.aspect = container.clientWidth / container.clientHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(container.clientWidth, container.clientHeight);
            }
        });
    </script>
</body>
</html>
