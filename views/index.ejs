<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Home - 3D App View</title>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Three.js for 3D Banner Effect -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; -webkit-tap-highlight-color: transparent; }

        body {
            background-color: #eef1f5;
            display: flex;
            justify-content: center;
        }

        /* App Container */
        .app-container {
            width: 100%;
            max-width: 414px;
            background: #fdfdfd;
            min-height: 100vh;
            position: relative;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            padding-bottom: 90px;
            overflow-x: hidden;
        }

        /* Header */
        .app-header {
            padding: 15px 20px; background: #fdfdfd; position: sticky; top: 0; z-index: 50;
        }
        .header-top { display: flex; align-items: center; justify-content: space-between; gap: 15px; }
        .search-box {
            flex: 1; background: #f4f5f7; display: flex; align-items: center;
            padding: 12px 15px; border-radius: 12px; gap: 10px;
        }
        .search-box input { border: none; background: transparent; outline: none; width: 100%; font-size: 13px; color: #1a1f36; }
        .search-box i { color: #8a8d93; }
        .header-icons { display: flex; gap: 15px; color: #1a1f36; font-size: 20px; }
        .icon-btn { position: relative; cursor: pointer; }
        .badge-dot {
            position: absolute; top: -2px; right: -4px; background: #ff4757; color: white;
            font-size: 9px; font-weight: bold; padding: 2px 5px; border-radius: 10px;
        }

        /* Hero Banner with 3D */
        .hero-banner {
            margin: 15px 20px; background: #f4f5f7; border-radius: 16px; padding: 25px 20px;
            position: relative; overflow: hidden; display: flex; flex-direction: column;
            justify-content: center; min-height: 180px;
        }
        .hero-content { position: relative; z-index: 10; width: 60%; }
        .hero-content p { font-size: 10px; font-weight: 600; color: #8a8d93; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px; }
        .hero-content h1 { font-size: 28px; font-weight: 800; color: #1a1f36; margin-bottom: 10px; line-height: 1.1; }
        .hero-content .desc { font-size: 11px; color: #8a8d93; margin-bottom: 15px; line-height: 1.4; }
        .btn-check {
            background: #1a1f36; color: white; border: none; padding: 10px 18px;
            border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer;
        }
        #banner-3d { position: absolute; right: -20px; top: 0; width: 55%; height: 100%; z-index: 1; }

        /* Icon Menu */
        .icon-menu { display: flex; justify-content: space-between; padding: 10px 25px 20px 25px; }
        .menu-item { display: flex; flex-direction: column; align-items: center; gap: 8px; cursor: pointer; }
        .menu-circle {
            width: 50px; height: 50px; background: #ffffff; border-radius: 15px;
            display: flex; align-items: center; justify-content: center;
            font-size: 20px; color: #1a1f36; box-shadow: 0 4px 10px rgba(0,0,0,0.05); border: 1px solid #f0f0f0;
        }
        .menu-item span { font-size: 11px; color: #8a8d93; font-weight: 500; }

        /* Section Title */
        .section-title { display: flex; justify-content: space-between; align-items: center; padding: 10px 20px 15px 20px; }
        .section-title h3 { font-size: 18px; font-weight: 700; color: #1a1f36; }
        .section-title span { font-size: 13px; color: #2f9c8f; font-weight: 600; cursor: pointer; }

        /* Horizontal Scroll Slider */
        .product-slider {
            display: flex; overflow-x: auto; gap: 15px; padding: 0 20px 20px 20px;
            scrollbar-width: none; scroll-snap-type: x mandatory;
        }
        .product-slider::-webkit-scrollbar { display: none; }

        /* Card Styles */
        .product-card {
            background: #ffffff; border-radius: 12px; overflow: hidden; border: 1px solid #eee;
            text-decoration: none; color: inherit; display: flex; flex-direction: column; position: relative;
        }
        .slider-card { min-width: 160px; scroll-snap-align: start; }
        .card-img-box { width: 100%; height: 160px; background: #f8f9fa; position: relative; }
        .card-img-box img { width: 100%; height: 100%; object-fit: cover; }
        .fav-icon {
            position: absolute; top: 10px; right: 10px; background: white; width: 28px; height: 28px;
            border-radius: 50%; display: flex; align-items: center; justify-content: center;
            font-size: 12px; color: #8a8d93; box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .card-details { padding: 12px; display: flex; flex-direction: column; flex-grow: 1; }
        .card-label { font-size: 10px; color: #8a8d93; margin-bottom: 4px; }
        .card-title {
            font-size: 12px; font-weight: 600; color: #1a1f36; margin-bottom: 8px;
            display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
        }
        .card-meta { display: flex; align-items: center; justify-content: space-between; margin-top: auto; }
        .card-price { font-size: 14px; font-weight: 700; color: #2f9c8f; }
        .card-rating { font-size: 11px; color: #8a8d93; display: flex; align-items: center; gap: 3px; }
        .card-rating i { color: #f39c12; }

        /* --- UNLIMITED VERTICAL GRID WITH 3D EFFECT --- */
        .vertical-grid-container {
            padding: 0 20px 20px 20px;
            perspective: 1000px; /* Gives 3D depth to the scroll effect */
        }
        .vertical-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }
        
        /* 3D Scroll Reveal Animation */
        .reveal-3d {
            opacity: 0;
            transform: translateY(60px) rotateX(-25deg) scale(0.9);
            transform-origin: top center;
            transition: all 0.7s cubic-bezier(0.23, 1, 0.32, 1);
        }
        .reveal-3d.visible {
            opacity: 1;
            transform: translateY(0) rotateX(0) scale(1);
        }

        /* Loader */
        .loader {
            text-align: center; padding: 20px; color: #8a8d93; font-size: 13px; font-weight: 600;
            display: flex; align-items: center; justify-content: center; gap: 8px;
        }
        .spinner {
            width: 16px; height: 16px; border: 2px solid #2f9c8f; border-top: 2px solid transparent;
            border-radius: 50%; animation: spin 1s linear infinite;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

        /* Bottom Nav */
        .bottom-nav {
            position: fixed; bottom: 0; width: 100%; max-width: 414px; background: #ffffff;
            border-top: 1px solid #eee; display: flex; justify-content: space-around; padding: 12px 0; z-index: 100;
        }
        .nav-item { display: flex; flex-direction: column; align-items: center; gap: 4px; text-decoration: none; color: #8a8d93; font-size: 11px; font-weight: 500; }
        .nav-item.active { color: #2f9c8f; }
        .nav-item i { font-size: 20px; margin-bottom: 2px; }
    </style>
</head>
<body>

    <div class="app-container">
        <!-- Header -->
        <div class="app-header">
            <div class="header-top">
                <div class="search-box">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" placeholder="Search...">
                </div>
                <div class="header-icons">
                    <div class="icon-btn"><i class="fa-regular fa-bell"></i><span class="badge-dot">5</span></div>
                    <div class="icon-btn"><i class="fa-regular fa-comment-dots"></i><span class="badge-dot" style="background:#2f9c8f;">2</span></div>
                </div>
            </div>
        </div>

        <!-- Hero Banner -->
        <div class="hero-banner">
            <div class="hero-content">
                <p>#Fashion Day</p>
                <h1>80% OFF</h1>
                <p class="desc">Discover 3D fashion that suits your style.</p>
                <button class="btn-check" onclick="window.location.href='/shop'">Check this out</button>
            </div>
            <div id="banner-3d"></div>
        </div>

        <!-- Menu -->
        <div class="icon-menu">
            <div class="menu-item"><div class="menu-circle"><i class="fa-solid fa-shapes"></i></div><span>Category</span></div>
            <div class="menu-item"><div class="menu-circle"><i class="fa-solid fa-cube" style="color: #2f9c8f;"></i></div><span>3D AR</span></div>
            <div class="menu-item"><div class="menu-circle"><i class="fa-solid fa-receipt"></i></div><span>Bill</span></div>
            <div class="menu-item"><div class="menu-circle"><i class="fa-solid fa-wifi"></i></div><span>Data plan</span></div>
            <div class="menu-item"><div class="menu-circle"><i class="fa-solid fa-mobile-screen"></i></div><span>Top Up</span></div>
        </div>

        <!-- Horizontal Slider (Best Sale) -->
        <div class="section-title">
            <h3>Best Sale Product</h3>
            <span onclick="window.location.href='/shop'">See more</span>
        </div>
        <div class="product-slider">
            <a href="/product" class="product-card slider-card">
                <div class="card-img-box"><img src="https://picsum.photos/400/500?random=1" alt="P"><div class="fav-icon"><i class="fa-regular fa-heart"></i></div></div>
                <div class="card-details">
                    <span class="card-label">Shirt</span><div class="card-title">Essentials Men's Short-Sleeve</div>
                    <div class="card-meta"><span class="card-rating"><i class="fa-solid fa-star"></i> 4.9</span><span class="card-price">$12.00</span></div>
                </div>
            </a>
            <a href="/product" class="product-card slider-card">
                <div class="card-img-box"><img src="https://picsum.photos/400/500?random=2" alt="P"><div class="fav-icon"><i class="fa-regular fa-heart"></i></div></div>
                <div class="card-details">
                    <span class="card-label">Jacket</span><div class="card-title">Colorblock Fleece Hoodie</div>
                    <div class="card-meta"><span class="card-rating"><i class="fa-solid fa-star"></i> 4.8</span><span class="card-price">$18.00</span></div>
                </div>
            </a>
            <a href="/product" class="product-card slider-card">
                <div class="card-img-box"><img src="https://picsum.photos/400/500?random=3" alt="P"><div class="fav-icon"><i class="fa-regular fa-heart"></i></div></div>
                <div class="card-details">
                    <span class="card-label">T-Shirt</span><div class="card-title">Premium Graphic Tee</div>
                    <div class="card-meta"><span class="card-rating"><i class="fa-solid fa-star"></i> 4.7</span><span class="card-price">$14.00</span></div>
                </div>
            </a>
        </div>

        <!-- Unlimited Vertical Feed with 3D Effect -->
        <div class="section-title" style="margin-top: 10px;">
            <h3>Discover For You</h3>
        </div>
        
        <div class="vertical-grid-container">
            <div class="vertical-grid" id="infinite-feed">
                <!-- Cards will be injected here via JavaScript -->
            </div>
        </div>

        <!-- Scroll Trigger & Loader -->
        <div id="loader-trigger" class="loader">
            <div class="spinner"></div> Generating 3D items...
        </div>

        <!-- Bottom Navigation Bar -->
        <div class="bottom-nav">
            <a href="/" class="nav-item active"><i class="fa-solid fa-house"></i><span>Home</span></a>
            <a href="/shop" class="nav-item"><i class="fa-solid fa-ticket"></i><span>Voucher</span></a>
            <a href="/shop" class="nav-item"><i class="fa-solid fa-wallet"></i><span>Wallet</span></a>
            <a href="/shop" class="nav-item"><i class="fa-solid fa-gear"></i><span>Settings</span></a>
        </div>
    </div>

    <script>
        // --- 1. LIVE 3D BANNER LOGIC ---
        const container = document.getElementById('banner-3d');
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 1000);
        camera.position.z = 4;

        const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
        renderer.setSize(container.clientWidth, container.clientHeight);
        container.appendChild(renderer.domElement);

        const ambientLight = new THREE.AmbientLight(0xffffff, 0.9);
        scene.add(ambientLight);
        const dirLight = new THREE.DirectionalLight(0xffffff, 1);
        dirLight.position.set(2, 2, 5);
        scene.add(dirLight);

        const geometry = new THREE.IcosahedronGeometry(1.2, 0);
        const material = new THREE.MeshStandardMaterial({ color: 0x1a1f36, wireframe: true, transparent: true, opacity: 0.7 });
        const innerGeo = new THREE.OctahedronGeometry(0.8, 0);
        const innerMat = new THREE.MeshStandardMaterial({ color: 0x2f9c8f, roughness: 0.2, metalness: 0.8 });

        const meshOuter = new THREE.Mesh(geometry, material);
        const meshInner = new THREE.Mesh(innerGeo, innerMat);
        scene.add(meshOuter); scene.add(meshInner);

        function animate3D() {
            requestAnimationFrame(animate3D);
            meshOuter.rotation.y += 0.005; meshOuter.rotation.x += 0.003;
            meshInner.rotation.y -= 0.01; meshInner.rotation.z += 0.005;
            renderer.render(scene, camera);
        }
        animate3D();

        // --- 2. INFINITE SCROLL & 3D REVEAL LOGIC ---
        const feedContainer = document.getElementById('infinite-feed');
        const loaderTrigger = document.getElementById('loader-trigger');
        let productCount = 10; 

        // Observer for 3D Reveal Effect
        const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                    revealObserver.unobserve(entry.target); // Reveal only once
                }
            });
        }, { threshold: 0.1, rootMargin: "0px 0px -50px 0px" });

        // Function to create new cards
        function loadMoreProducts() {
            for (let i = 0; i < 4; i++) { // Load 4 cards at a time
                productCount++;
                const card = document.createElement('a');
                card.href = '/product';
                card.className = 'product-card reveal-3d'; // Add reveal class
                
                // Randomize details for demo
                const price = Math.floor(Math.random() * (40 - 10 + 1) + 10);
                const rating = (Math.random() * (5.0 - 4.0) + 4.0).toFixed(1);

                card.innerHTML = `
                    <div class="card-img-box">
                        <img src="https://picsum.photos/400/500?random=${productCount}" alt="Product">
                        <div class="fav-icon"><i class="fa-regular fa-heart"></i></div>
                    </div>
                    <div class="card-details">
                        <span class="card-label">Spatial Wear</span>
                        <div class="card-title">Modern 3D Fit Item #${productCount}</div>
                        <div class="card-meta">
                            <span class="card-rating"><i class="fa-solid fa-star"></i> ${rating}</span>
                            <span class="card-price">$${price}.00</span>
                        </div>
                    </div>
                `;
                
                feedContainer.appendChild(card);
                revealObserver.observe(card); // Attach observer to new card
            }
        }

        // Observer for Infinite Scrolling
        const infiniteScrollObserver = new IntersectionObserver((entries) => {
            if (entries[0].isIntersecting) {
                setTimeout(() => {
                    loadMoreProducts();
                }, 800); // slight delay to show loading animation
            }
        });

        // Initialize First Batch & Observers
        loadMoreProducts();
        infiniteScrollObserver.observe(loaderTrigger);

    </script>
</body>
</html>
