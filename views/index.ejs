<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Webglut - Immersive 3D Experience</title>
    
    <!-- Three.js for 3D Background -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <!-- GSAP for Smooth Animations -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Syncopate:wght@400;700&family=Inter:wght@300;400;600&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #050505;
            color: #ffffff;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
            /* Smooth scrolling */
            scroll-behavior: smooth;
        }

        /* Fixed 3D Background */
        #webgl-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1;
            background: radial-gradient(circle at center, #1a1a2e 0%, #050505 100%);
        }

        /* Navbar */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 30px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 100;
            mix-blend-mode: difference;
        }
        .logo {
            font-family: 'Syncopate', sans-serif;
            font-size: 24px;
            font-weight: 700;
            letter-spacing: 2px;
        }
        .nav-links {
            display: flex;
            gap: 40px;
        }
        .nav-links a {
            color: white;
            text-decoration: none;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
        }

        /* Content Sections */
        .content {
            position: relative;
            z-index: 10;
        }

        section {
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 0 10%;
        }

        /* Hero Section */
        .hero {
            align-items: center;
            text-align: center;
        }
        .hero h1 {
            font-family: 'Syncopate', sans-serif;
            font-size: 5vw;
            line-height: 1.1;
            text-transform: uppercase;
            letter-spacing: -2px;
            margin-bottom: 20px;
            opacity: 0;
            transform: translateY(50px);
        }
        .hero p {
            font-size: 1.2rem;
            color: #a0a0a0;
            max-width: 600px;
            margin-bottom: 40px;
            opacity: 0;
        }
        .explore-btn {
            padding: 15px 40px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            background: transparent;
            color: white;
            font-family: 'Syncopate', sans-serif;
            text-transform: uppercase;
            font-size: 12px;
            letter-spacing: 2px;
            cursor: pointer;
            transition: all 0.3s ease;
            opacity: 0;
            backdrop-filter: blur(5px);
        }
        .explore-btn:hover {
            background: white;
            color: black;
        }

        /* Second Section */
        .story {
            align-items: flex-start;
        }
        .story h2 {
            font-family: 'Syncopate', sans-serif;
            font-size: 4vw;
            margin-bottom: 30px;
            max-width: 800px;
        }
        .story p {
            font-size: 1.2rem;
            color: #a0a0a0;
            max-width: 500px;
            line-height: 1.8;
        }
    </style>
</head>
<body>

    <!-- 3D Canvas Background -->
    <div id="webgl-container"></div>

    <nav>
        <div class="logo">WEBGLUT</div>
        <div class="nav-links">
            <a href="/shop">Collection</a>
            <a href="#">About</a>
            <a href="#">Contact</a>
        </div>
    </nav>

    <div class="content">
        <!-- Hero Section -->
        <section class="hero">
            <h1 class="anim-title">Fashion Meets<br>Architecture</h1>
            <p class="anim-sub">Experience clothing in a spatial dimension. Scroll down to dive into the storm.</p>
            <button class="explore-btn anim-btn" onclick="window.location.href='/shop'">Enter The Store</button>
        </section>

        <!-- Story Section -->
        <section class="story">
            <h2>Depth is a kind of Index.</h2>
            <p>Every garment is a weather event. Position records force. Fabric records time. Discover our 3D ready collection.</p>
        </section>
        
        <!-- More empty space to allow scrolling -->
        <section style="height: 50vh; justify-content: flex-end; padding-bottom: 50px; align-items: center;">
            <p style="color: #666; font-family: 'Syncopate'; font-size: 12px; letter-spacing: 2px;">© 2026 WEBGLUT</p>
        </section>
    </div>

    <script>
        // --- GSAP TEXT ANIMATIONS ---
        gsap.to(".anim-title", { opacity: 1, y: 0, duration: 1.5, ease: "power4.out", delay: 0.5 });
        gsap.to(".anim-sub", { opacity: 1, duration: 1.5, delay: 1 });
        gsap.to(".anim-btn", { opacity: 1, duration: 1.5, delay: 1.2 });

        // --- THREE.JS IMMERSIVE CINEMATIC SETUP ---
        const container = document.getElementById('webgl-container');
        const scene = new THREE.Scene();
        // Adding dense fog for that moody, atmospheric look
        scene.fog = new THREE.FogExp2(0x050505, 0.04);

        const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.z = 15;

        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(window.devicePixelRatio);
        container.appendChild(renderer.domElement);

        // Premium Lighting
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.2);
        scene.add(ambientLight);

        const spotLight = new THREE.SpotLight(0xffffff, 5);
        spotLight.position.set(10, 20, 10);
        spotLight.angle = Math.PI / 4;
        spotLight.penumbra = 0.5;
        scene.add(spotLight);

        const blueLight = new THREE.PointLight(0x4a90e2, 3, 50);
        blueLight.position.set(-10, -10, 5);
        scene.add(blueLight);

        // Abstract Floating Particles / Architecture
        const particlesGeometry = new THREE.BufferGeometry();
        const particlesCount = 2500;
        const posArray = new Float32Array(particlesCount * 3);

        for(let i = 0; i < particlesCount * 3; i++) {
            posArray[i] = (Math.random() - 0.5) * 40;
        }
        particlesGeometry.setAttribute('position', new THREE.BufferAttribute(posArray, 3));

        const material = new THREE.PointsMaterial({
            size: 0.05,
            color: 0xffffff,
            transparent: true,
            opacity: 0.6,
            blending: THREE.AdditiveBlending
        });

        const particlesMesh = new THREE.Points(particlesGeometry, material);
        scene.add(particlesMesh);

        // Huge Abstract Object (Representing the storm/depth)
        const geometry = new THREE.IcosahedronGeometry(6, 1);
        const wireframeMaterial = new THREE.MeshStandardMaterial({
            color: 0x222222,
            wireframe: true,
            transparent: true,
            opacity: 0.3
        });
        const mainObject = new THREE.Mesh(geometry, wireframeMaterial);
        scene.add(mainObject);

        // Mouse Parallax Effect
        let mouseX = 0;
        let mouseY = 0;
        let targetX = 0;
        let targetY = 0;
        const windowHalfX = window.innerWidth / 2;
        const windowHalfY = window.innerHeight / 2;

        document.addEventListener('mousemove', (event) => {
            mouseX = (event.clientX - windowHalfX);
            mouseY = (event.clientY - windowHalfY);
        });

        // Scroll Effect
        let scrollY = window.scrollY;
        window.addEventListener('scroll', () => {
            scrollY = window.scrollY;
        });

        // Animation Loop
        const clock = new THREE.Clock();
        function animate() {
            requestAnimationFrame(animate);
            const elapsedTime = clock.getElapsedTime();

            targetX = mouseX * 0.001;
            targetY = mouseY * 0.001;

            // Smooth parallax based on mouse
            particlesMesh.rotation.y += 0.05 * (targetX - particlesMesh.rotation.y);
            particlesMesh.rotation.x += 0.05 * (targetY - particlesMesh.rotation.x);
            
            // Slow continuous rotation
            mainObject.rotation.y += 0.002;
            mainObject.rotation.x += 0.001;

            // Camera movement tied to scroll (gives the cinematic depth feel)
            camera.position.y = -scrollY * 0.01;
            mainObject.position.y = scrollY * 0.005; 
            mainObject.rotation.z = scrollY * 0.002;

            renderer.render(scene, camera);
        }
        animate();

        // Responsive handling
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    </script>
</body>
</html>
