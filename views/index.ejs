<script>
  // Infinite Scroll Logic
  const productGrid = document.getElementById('productGrid');
  const loader = document.getElementById('loader');

  // Dummy products
  const dummyData = [
    { title: "Matt Black Mortise Lock Set", img: "https://images.unsplash.com/photo-1542010589005-d1eabd394997?w=300&q=80" },
    { title: "Aluminium Door Closer", img: "https://images.unsplash.com/photo-1621905251189-08b45d6a269e?w=300&q=80" },
    { title: "Brass Aldrop for Double Doors", img: "https://images.unsplash.com/photo-1589939705384-5185137a7f0f?w=300&q=80" },
    { title: "Magnetic Door Stopper", img: "https://images.unsplash.com/photo-1558025232-0c9f133bc420?w=300&q=80" }
  ];

  function loadMoreProducts() {
    loader.style.display = 'block';
    setTimeout(() => {
      let html = '';
      for(let i=0; i<4; i++) {
        let p = dummyData[i % dummyData.length];
        html += `
          <a href="shop.ejs" class="product-card">
            <img src="${p.img}" class="product-img" alt="Hardware">
            <div class="product-title">${p.title}</div>
            <div class="view-btn">View Details</div>
          </a>
        `;
      }
      productGrid.insertAdjacentHTML('beforeend', html);
      loader.style.display = 'none';
    }, 1000);
  }

  const observer = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting) {
      loadMoreProducts();
    }
  }, { rootMargin: '100px' });
  observer.observe(loader);
</script>

